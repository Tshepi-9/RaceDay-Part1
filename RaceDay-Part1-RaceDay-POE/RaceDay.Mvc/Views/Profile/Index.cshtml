@model RaceDay.Mvc.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    string? pictureFileName = string.IsNullOrEmpty(Model.ProfilePictureUrl)
        ? null
        : System.IO.Path.GetFileName(Model.ProfilePictureUrl);
}

<div class="container mt-4">

    <h2 class="mb-3">My Profile</h2>

    <p class="text-muted">
        View and update your personal account information.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h4>Profile Picture</h4>

            @if (!string.IsNullOrEmpty(pictureFileName))
            {
                <img src="@Url.Action("Picture", "Profile", new { fileName = pictureFileName })"
                     alt="Profile picture"
                     class="rounded-circle mb-3"
                     style="width:150px; height:150px; object-fit:cover;" />
            }
            else
            {
                <p class="text-muted">
                    You have not uploaded a profile picture yet.
                </p>
            }

            <form asp-controller="Profile"
                  asp-action="UploadPicture"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">
                        Choose a profile picture
                    </label>

                    <input type="file"
                           name="file"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />
                </div>

                <button type="submit" class="btn btn-success">
                    Upload Picture
                </button>

            </form>

            <small class="text-muted d-block mt-2">
                JPG, JPEG, PNG or WEBP. Maximum size: 5 MB.
            </small>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-3">Personal Information</h4>

            <form asp-controller="Profile"
                  asp-action="Index"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="FirstName" class="form-label">
                        First Name
                    </label>

                    <input asp-for="FirstName" class="form-control" />

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="LastName" class="form-label">
                        Last Name
                    </label>

                    <input asp-for="LastName" class="form-control" />

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email" class="form-control" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Phone" class="form-label">
                        Phone Number
                    </label>

                    <input asp-for="Phone" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Account Role</label>

                    <input value="@Model.Role"
                           class="form-control"
                           readonly />
                </div>

                <button type="submit" class="btn btn-primary">
                    Save Changes
                </button>

                <a asp-controller="Participant"
                   asp-action="Index"
                   class="btn btn-secondary">
                    Back to Dashboard
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}