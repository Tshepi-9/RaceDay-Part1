@model List<RaceDay.Mvc.ViewModels.EventViewModel>

@{
    ViewData["Title"] = "Manage Events";
}

<div class="container mt-4">

    <h1>Manage Events</h1>

    <p>Create, view, update and manage your RaceDay events.</p>

    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">
        Create New Event
    </a>

    @if (Model == null || Model.Count == 0)
    {
        <div class="alert alert-info">
            You have not created any events yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead>
                    <tr>
                        <th>Event Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>Location</th>
                        <th>Distance (km)</th>
                        <th>Event Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.EventName</td>

                            <td>@item.Description</td>

                            <td>
                                @item.EventDate.ToString("dd/MM/yyyy")
                            </td>

                            <td>@item.Location</td>

                            <td>@item.Distance</td>

                            <td>@item.EventType</td>

                            <td>

                                <a asp-controller="ManageCategories"
                                   asp-action="Index"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-info btn-sm mb-1">
                                    Manage Categories
                                </a>

                                <a asp-controller="ManageEnrolments"
                                   asp-action="Index"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-success btn-sm mb-1">
                                    Manage Enrolments
                                </a>

                                <a asp-controller="ManageResults"
                                   asp-action="Index"
                                   asp-route-eventId="@item.EventID"
                                   class="btn btn-primary btn-sm mb-1">
                                    Manage Results
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.EventID"
                                   class="btn btn-warning btn-sm mb-1">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.EventID"
                                      method="post"
                                      style="display:inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm mb-1"
                                            onclick="return confirm('Are you sure you want to delete this event?')">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <hr />

    <a asp-controller="Organiser"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>