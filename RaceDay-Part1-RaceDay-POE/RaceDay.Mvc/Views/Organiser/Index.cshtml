@{
    ViewData["Title"] = "Organiser Dashboard";
}

<div class="container mt-4">

    <h1>Organiser Dashboard</h1>

    <p>
        Welcome, @Context.Session.GetString("DisplayName").
        Manage your RaceDay activities from here.
    </p>

    <hr />

    <div class="row">

        <!-- Manage Events -->
        <div class="col-md-4 mb-3">
            <div class="card p-3 h-100">
                <h4>Manage Events</h4>
                <p>Create, update, view and delete your running, walking and cycling events.</p>

                <a asp-controller="ManageEvents"
                   asp-action="Index"
                   class="btn btn-primary">
                    Manage Events
                </a>
            </div>
        </div>

        <!-- Enrolments -->
        <div class="col-md-4 mb-3">
            <div class="card p-3 h-100">
                <h4>Enrolments</h4>
                <p>View and manage participant enrolments.</p>

                <a asp-controller="Organiser"
                   asp-action="Enrolments"
                   class="btn btn-primary">
                    View Enrolments
                </a>
            </div>
        </div>

        <!-- Results -->
        <div class="col-md-4 mb-3">
            <div class="card p-3 h-100">
                <h4>Results</h4>
                <p>Manage participant results and event performance.</p>

                <a asp-controller="Organiser"
                   asp-action="Results"
                   class="btn btn-primary">
                    Manage Results
                </a>
            </div>
        </div>

    </div>

    <hr />

    <form asp-controller="Auth"
          asp-action="Logout"
          method="post">

        <button type="submit" class="btn btn-danger">
            Logout
        </button>

    </form>

</div>