@model List<RaceDay.Mvc.ViewModels.EnrolmentViewModel>

@{
    ViewData["Title"] = "My Events";
}

<div class="container mt-4">

    <h2 class="mb-3">My Events</h2>

    <p class="text-muted">
        View all the events you have entered and check your enrolment status.
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">
            @ViewBag.Error
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not entered any events yet.

            <br />

            Browse upcoming events to find an event you would like to enter.
        </div>

        <a asp-controller="BrowseEvents"
           asp-action="Index"
           class="btn btn-primary">
            Browse Events
        </a>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event Name</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>

                            <td>@item.CategoryName</td>

                            <td>
                                @item.EnrolmentDate.ToString("dd MMMM yyyy")
                            </td>

                            <td>
                                @if (item.Status == "Confirmed")
                                {
                                    <span class="badge bg-success">
                                        @item.Status
                                    </span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.Status
                                    </span>
                                }
                                else if (item.Status == "Cancelled")
                                {
                                    <span class="badge bg-danger">
                                        @item.Status
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <a asp-controller="BrowseEvents"
           asp-action="Index"
           class="btn btn-primary">
            Browse More Events
        </a>
    }

    <br />
    <br />

    <a asp-controller="Participant"
       asp-action="Index"
       class="btn btn-secondary">
        Back to Dashboard
    </a>

</div>